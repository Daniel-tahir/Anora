# Copy to .env (local) / set in Vercel Project Settings (production). NEVER commit real values.

# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key            # public, safe for the browser (protected by RLS + RPC grants)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # SERVER ONLY - bypasses RLS. Never expose or prefix with VITE_

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal (server rejects webhooks until PAYPAL_WEBHOOK_ID is set) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=production                   # or sandbox
VITE_PAYPAL_CLIENT_ID=

# --- Email ---
RESEND_API_KEY=re_...

# --- App ---
PUBLIC_APP_URL=https://your-domain.com
VITE_PUBLIC_APP_URL=https://your-domain.com
